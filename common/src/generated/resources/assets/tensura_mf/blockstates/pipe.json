{
  "multipart": [
    {
      "apply": {
        "model": "tensura_mf:block/pipe_core"
      }
    },
    {
      "apply": {
        "model": "tensura_mf:block/pipe_arm_north"
      },
      "when": {
        "north": "true"
      }
    },
    {
      "apply": {
        "model": "tensura_mf:block/pipe_arm_south"
      },
      "when": {
        "south": "true"
      }
    },
    {
      "apply": {
        "model": "tensura_mf:block/pipe_arm_east"
      },
      "when": {
        "east": "true"
      }
    },
    {
      "apply": {
        "model": "tensura_mf:block/pipe_arm_west"
      },
      "when": {
        "west": "true"
      }
    },
    {
      "apply": {
        "model": "tensura_mf:block/pipe_arm_up"
      },
      "when": {
        "up": "true"
      }
    },
    {
      "apply": {
        "model": "tensura_mf:block/pipe_arm_up_south"
      },
      "when": {
        "south": "true",
        "up": "true"
      }
    },
    {
      "apply": {
        "model": "tensura_mf:block/pipe_arm_up_north"
      },
      "when": {
        "north": "true",
        "up": "true"
      }
    },
    {
      "apply": {
        "model": "tensura_mf:block/pipe_arm_up_east"
      },
      "when": {
        "east": "true",
        "up": "true"
      }
    },
    {
      "apply": {
        "model": "tensura_mf:block/pipe_arm_up_west"
      },
      "when": {
        "up": "true",
        "west": "true"
      }
    },
    {
      "apply": {
        "model": "tensura_mf:block/pipe_arm_down"
      },
      "when": {
        "down": "true"
      }
    }
  ]
}